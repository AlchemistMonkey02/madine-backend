# Copy this file to .env and fill in real values. Never commit .env.

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=madine
MONGODB_COLLECTION=madine_core

# Set to "production" on the live server
NODE_ENV=development
PORT=4000

# --- Only needed on your own computer (ingest / prepare-images scripts) ---
DATASET_JSON_PATH=C:\Project\JAIPUR_CAFE_DATASET\JAIPUR_CAFE_DATASET\Jaipur_Zomato_Swiggy_Master.json
DATASET_ROOT=C:\Project\JAIPUR_CAFE_DATASET\JAIPUR_CAFE_DATASET

# --- Email (login codes). Leave SMTP_HOST empty in dev to print codes to the console ---
# Gmail: host smtp.gmail.com, port 465, user = your Gmail, pass = a 16-char App Password
# Brevo: host smtp-relay.brevo.com, port 587, user/pass from Brevo > SMTP & API
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM="MADINE <you@example.com>"

# Public site address used in email links (e.g. https://madine.onrender.com). Defaults to http://localhost:PORT
APP_URL=
